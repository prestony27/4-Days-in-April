{
  "version": 2,
  "functions": {
    "api/index.py": {
      "runtime": "@vercel/python@4.0"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.py"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/update-scores",
      "schedule": "*/2 * * * *"
    }
  ]
}
